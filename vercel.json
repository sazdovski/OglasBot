{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/search", "destination": "/api/search" },
    { "source": "/api/pazar3", "destination": "/api/pazar3" },
    { "source": "/api/itmk", "destination": "/api/itmk" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
